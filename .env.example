# Copy to .env and adjust. All values are optional — defaults are in src/abc/config.py.

# Seasons to ingest (comma-separated years). Default: 2023,2024,2025
ABC_YEARS=2023,2024,2025

# Polymarket API base URLs (override only if behind a proxy)
ABC_POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
ABC_POLYMARKET_CLOB_URL=https://clob.polymarket.com
ABC_POLYMARKET_DATA_URL=https://data-api.polymarket.com

# HTTP behavior
ABC_HTTP_MAX_RETRIES=5
ABC_HTTP_TIMEOUT=30

# Concurrency for price-history fetching (Polymarket public API — keep modest)
ABC_PRICE_CONCURRENCY=4

# nflreadpy cache
NFLREADPY_CACHE=filesystem
NFLREADPY_CACHE_DIR=~/.cache/nflreadpy
NFLREADPY_CACHE_DURATION=86400
